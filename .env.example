# ---------------------------------------------------------------------------
# Salin file ini menjadi .env.local lalu isi nilainya. Jangan commit .env.local.
# ---------------------------------------------------------------------------

# --- Supabase (Auth) -------------------------------------------------------
# Ambil dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
# Service-role key: HANYA dipakai di server (seed & admin task). Jangan pernah
# diekspos ke browser dan jangan diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# --- Postgres --------------------------------------------------------------
# DATABASE_URL  : dipakai aplikasi saat runtime. Untuk Supabase gunakan
#                 Transaction Pooler (port 6543).
# DIRECT_URL    : dipakai drizzle-kit untuk migrasi & DDL. Untuk Supabase
#                 gunakan Direct Connection / Session Pooler (port 5432).
#
# Supabase:
#   DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
#   DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
#
# Postgres lokal via docker-compose.yml (port host 5433):
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5433/project_control"
#   DIRECT_URL="postgresql://postgres:postgres@localhost:5433/project_control"
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/project_control"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/project_control"

# --- Aplikasi --------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Semua tanggal ditampilkan dan dipotong per periode dalam zona waktu ini.
APP_TIMEZONE="Asia/Jakarta"

# --- Seed demo -------------------------------------------------------------
# Dipakai oleh `npm run db:seed`. Ketiga akun dibuat lewat Supabase Auth Admin
# API dan memakai SEED_ADMIN_PASSWORD yang sama.
#
# Supabase menolak domain yang tidak dapat menerima email pada sebagian
# konfigurasi. Bila `db:seed` gagal dengan "Email address is invalid",
# ganti ke domain sungguhan yang Anda kuasai.
SEED_ADMIN_EMAIL="admin@demo.test"
SEED_ENGINEER_EMAIL="engineer@demo.test"
SEED_FIELD_EMAIL="lapangan@demo.test"
# Minimal 8 karakter. Dipakai untuk ketiga akun demo.
SEED_ADMIN_PASSWORD="Demo12345!"
